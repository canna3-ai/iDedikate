# App-specific R8 keep rules. Libraries (Firebase, Play Services, Room, Retrofit, Moshi,
# kotlinx.serialization, ARCore, SceneView/Filament) ship their own consumer rules.

# Keep file/line info so Play Console can de-obfuscate crash stack traces with the mapping file.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# Navigation 3's rememberNavBackStack saves NavKeys by class name and looks up their
# serializers reflectively when restoring state (e.g. after process death).
-keep class * implements androidx.navigation3.runtime.NavKey { *; }
-keepclassmembers class * implements androidx.navigation3.runtime.NavKey {
    public static ** Companion;
    public static ** INSTANCE;
}
-keep @kotlinx.serialization.Serializable class com.memoria.idedikate.** { *; }
